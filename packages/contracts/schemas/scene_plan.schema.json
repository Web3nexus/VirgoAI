{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virgoAi/scene_plan.v1",
  "title": "ScenePlan",
  "type": "object",
  "required": ["version", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "section_id", "start_seconds", "end_seconds", "duration_seconds",
                     "character_ids", "environment_id", "shot_type", "keyframe_prompt", "motion_prompt"],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "$ref": "#/$defs/id" },
          "section_id": { "$ref": "#/$defs/id" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "character_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "visible_speaker_id": { "$ref": "#/$defs/id", "description": "Set when a character with a visible face speaks in this scene. Drives lip-sync." },
          "environment_id": { "$ref": "#/$defs/id" },
          "shot_type": { "enum": ["wide", "medium", "close_up", "extreme_close_up", "insert"] },
          "keyframe_prompt": { "type": "string", "minLength": 20 },
          "motion_prompt": { "type": "string", "minLength": 10 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
