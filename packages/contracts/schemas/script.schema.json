{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virgoAi/script.v1",
  "title": "Script",
  "type": "object",
  "required": ["version", "title", "audio_mode", "sections"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "audio_mode": { "enum": ["narration", "dialogue", "both"] },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "purpose", "environment_id", "character_ids", "start_seconds", "end_seconds"],
        "additionalProperties": false,
        "properties": {
          "section_id": { "$ref": "#/$defs/id" },
          "purpose": { "enum": ["hook", "setup", "build", "climax", "landing"] },
          "environment_id": { "$ref": "#/$defs/id" },
          "character_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "narration": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "lines": {
      "type": "array",
      "description": "Speaker-tagged dialogue lines. Required when audio_mode is dialogue or both.",
      "items": {
        "type": "object",
        "required": ["line_id", "section_id", "speaker", "text", "start_seconds", "end_seconds"],
        "additionalProperties": false,
        "properties": {
          "line_id": { "$ref": "#/$defs/id" },
          "section_id": { "$ref": "#/$defs/id" },
          "speaker": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1 },
          "emotion": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "if": { "properties": { "audio_mode": { "enum": ["dialogue", "both"] } }, "required": ["audio_mode"] },
  "then": { "required": ["lines"], "properties": { "lines": { "type": "array", "minItems": 1 } } },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
  }
}
