{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virgoAi/publish_log.v1",
  "title": "PublishLog",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "status"],
        "additionalProperties": false,
        "properties": {
          "platform": { "enum": ["youtube", "tiktok", "instagram_reels", "youtube_shorts", "other"] },
          "status": { "enum": ["scheduled", "published", "failed"] },
          "url": { "type": "string", "format": "uri" },
          "published_at": { "type": "string", "format": "date-time" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
