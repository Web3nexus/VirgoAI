{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virgoai/brief.v1",
  "title": "Brief",
  "type": "object",
  "required": ["version", "title", "input", "audio_mode", "target_duration_seconds", "platform"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "input": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["youtube_url", "transcript", "upload", "script", "idea"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "audio_mode": { "enum": ["narration", "dialogue", "both"] },
    "target_duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
    "platform": { "enum": ["youtube", "tiktok", "instagram_reels", "youtube_shorts", "other"] },
    "audience": { "type": "string", "maxLength": 500 },
    "tone": { "type": "string", "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "default": "en" }
  }
}
