{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "virgoAi/edit_decisions.v1",
  "title": "EditDecisions",
  "type": "object",
  "required": ["version", "render_runtime", "output", "timeline"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "render_runtime": { "enum": ["remotion", "ffmpeg"] },
    "output": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "asset_id", "track", "in_seconds", "out_seconds"],
        "additionalProperties": false,
        "properties": {
          "scene_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "asset_id": { "type": "string", "minLength": 1 },
          "track": { "enum": ["video", "narration", "dialogue", "score"] },
          "in_seconds": { "type": "number", "minimum": 0 },
          "out_seconds": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
